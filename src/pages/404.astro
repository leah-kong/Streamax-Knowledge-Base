---
import '../styles/global.css';

const BASE = import.meta.env.BASE_URL ?? '/';
const home = BASE.replace(/\/+$/, '') + '/';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 · Página no encontrada</title>
  </head>
  <body>
    <main style="max-width:760px;margin:0 auto;padding:96px 24px;text-align:center;">
      <p style="font-size:64px;font-weight:700;margin:0;color:var(--accent-dark);">404</p>
      <p style="color:var(--ink-soft);font-size:15px;margin:12px 0 28px;">
        La página que buscas no existe o fue movida.
      </p>
      <a href={home} style="color:var(--brand);font-weight:600;text-decoration:none;">
        Volver al inicio →
      </a>
    </main>
  </body>
</html>
